MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1229745729}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 9913fec5ac2c04c4283a443caab34cd3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SignalLost.DialogueSource
  speaker: Dr. Reyes
  prompt: Talk to Dr. Reyes
  lines:
  - You made it... good. OVERSEER took over the drones and robot guards after the
    lightning strike. It thinks we're intruders.
  - It also started a Purge Protocol. In twenty minutes the defense grid fires on
    everything left on this island.
  - The radio tower can call a rescue boat, but it needs three override fuses. Two
    are in the underground utility wings, one at the tower.
  - "My leg's broken, so it has to be you. I've unlocked the armory \u2013 take the
    Arc Pistol. Aim for their glowing eyes and visors."
  repeatLines:
  - "The fuses are in Wings A and B below, and one at the radio tower. Go \u2013
    I'll guide you over the radio."
  persistentId: Briefing
  objectiveOnFinish: Take the Arc Pistol from the armory
  onFinished:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1832808663}
        m_TargetAssemblyTypeName: SignalLost.Door, Assembly-CSharp
        m_MethodName: Unlock
        m_Mode: 0
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: 
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
